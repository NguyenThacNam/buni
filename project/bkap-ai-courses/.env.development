# Chỉ áp dụng khi chạy `npm start`.
# Dev server và Spring Boot nằm ở 2 port khác nhau nên phải gọi API bằng URL tuyệt đối.
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1

# Backend chỉ cho phép CORS từ http://localhost:3001
# (xem WebConfiguration.corsConfigurationSource) nên cố định port dev về 3001.
PORT=3001
