# Giá trị mặc định dùng chung cho mọi môi trường.
# CRA chỉ đọc biến có tiền tố REACT_APP_ và nhúng cứng lúc build,
# nên đổi file này xong phải chạy lại npm start / npm run build.
#
# Ghi đè cục bộ (không commit): .env.local, .env.development.local, .env.production.local

# Đường dẫn gốc của REST API. Để tương đối => gọi cùng origin với trang web,
# đúng với trường hợp build FE rồi nhúng vào static/ của Spring Boot.
REACT_APP_API_BASE_URL=/api/v1

# Hệ thống LMS Moodle bên ngoài
REACT_APP_LMS_URL=https://lms.buni.vn
