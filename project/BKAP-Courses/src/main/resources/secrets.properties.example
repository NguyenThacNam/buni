# ==============================================================================
# MẪU — chép thành secrets.properties (cùng thư mục) rồi điền giá trị thật
# ==============================================================================
# secrets.properties bị .gitignore bỏ qua, không bao giờ lên git.
# application.properties nạp nó qua spring.config.import. Thiếu file này thì
# ứng dụng dừng ngay lúc khởi động vì không có khóa.

# Mật khẩu PostgreSQL
# Không còn dùng — buni đã bỏ CSDL riêng.
# spring.datasource.password=DIEN_MAT_KHAU_POSTGRES

# Token dịch vụ web của Moodle (dịch vụ TokenBuni trên lms.buni.vn).
# Lấy ở: Quản trị hệ thống → Máy chủ → Dịch vụ web → Quản lý token.
moodle.token=DIEN_TOKEN_MOODLE

# Khóa dùng chung với plugin JWT trên Moodle. Hiện CHƯA code nào dùng tới.
moodle.jwt.secret=DIEN_CHUOI_NGAU_NHIEN_TOI_THIEU_32_KY_TU

# Khóa ký access token — chuỗi ngẫu nhiên, tối thiểu 32 ký tự.
app.jwt.secret=DIEN_CHUOI_NGAU_NHIEN_TOI_THIEU_32_KY_TU
